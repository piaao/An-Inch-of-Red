# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ---------------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/

# ------------------------------------------------- Blender 自动备份（不是产物）
*.blend1

# ================================================================ 本机中间产物
# work/ 是「跑一次就重新生成」的地方：验收日志、逐像素取证图、评估 JSON。
# 真正要留的两类东西都分别入库了 ——
#   data/     派生链的实测底账（重建竞技场快照要用）
#   reports/  关键验收报告快照
# 所以 work/ 整体不入库，git status 永远干净，迭代时不会被上百份日志刷屏。
/work/*
!/work/.gitkeep

# ============================================================ 本机工作区记忆
# 上面那句「.workbuddy/ 在仓库之外」**是错的** —— 实测它就在仓库根下
# （agent 的记忆目录由本机决定，不跟着仓库走）。里面是工作日志与项目约定，
# 是写给下一个会话看的内部笔记，不是交付物；而这个远端是**公开**仓库。
# 所以这里显式排除，让上面那句话变成真的。
/.workbuddy/

# 一次性的补丁 / 私有探针脚本：它们的**产物**已经进 git，脚本本身是行动记录，
# 不是工具。留下来的 scripts/ 只放能反复跑的验证器与诊断器。
/scripts/_*
/scripts/patch_*

# ======================================= 生成器的一次性产物（每次运行都会重写）
# scripts/procgen.mjs 与 scripts/verify_gen_play.mjs 每次跑都会重写这两个文件；
# 它们是产物而不是源码，入库只会让 diff 每次都不一样。
/game/arenas/gen.json
/js/layout.gen.js
# 每个参数组合一套的截图，会随参数无限增长
/renders/gen/
# 工作台每次运行都会重写的截图，同样是产物
/renders/ui/
# 一次性取证摘要（A/B 路由对照等），与 work/ 同类
/reports/_*
# 改文件前的原样备份：只用于找回，绝不入库
/_bak/

# ============================================================ 根目录临时探针
# 一次性取证脚本与它们的输出（一律以 _ 开头、且只在本目录生效）
/_*.py
/_*.txt
/_*.log
/_*.ps1

# ================================================ 发布目录（产物，不入库）
# dist/ 是 scripts/build_dist.py 从白名单同步出来的**要发出去的那一份**：
# 221 个文件、5.8 MB、228 份拷贝。它由源码 100% 决定（verify_dist 有一条
# 「dist 与当前源码逐字节一致」钉着），入库只会把仓库体积翻一倍、
# 还要在每次改一行 JS 时带出 200 多个二进制 diff。
# 「跑一次就重生成」的产物一律不入库 —— 和 work/ 同理。
/dist/

# ====================================================== 本机密钥（绝不入库）
# 配置.yaml 存的是百炼 API Key。远端是公开的 GitHub 仓库，
# 一旦被 `git add .` 带走就等于把钥匙挂在门口。
# 需要它的只有 scripts/gen_music.py（生成配乐）与 scripts/verify_music.mjs 之外的
# 生成链路，它们都在本机跑，不需要仓库里有这把钥匙。
/配置.yaml

# ================================================================ 生成的配乐
# game/MUSIC.md 是设计书（入库）；七首曲子是产物（不入库）。
# 它们由 scripts/gen_music.py 调百炼 fun-music-v1 生成，和 work/ 同类 ——
# 「跑一次就有」，且是本仓库唯一会被排除的二进制。
# 运行时的 game/play/music.js 只认 manifest.json：没有它，音乐整个关闭、零 404。
# 所以整目录不入库，包括 manifest —— 它描述的文件本来就不在仓库里。
/assets/audio/
